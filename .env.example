# TRINETRA Operational Environment Configuration

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-trinetra-operational-intelligence-2026
PORT=5000

# Database Configuration (Relative to project root or absolute path)
DATABASE_PATH=database/trinetra.db

# Observability & Logging (DEBUG, INFO, WARNING, ERROR)
